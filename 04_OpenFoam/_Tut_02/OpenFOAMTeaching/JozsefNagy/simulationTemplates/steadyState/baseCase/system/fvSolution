FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          PCG;
		preconditioner  DIC;
        tolerance       1e-04;//
        relTol          1e-04;//
    }
    "(U|k|epsilon|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-04;//
        relTol          1e-04;//
    }
}
SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      yes;
    residualControl
    {
        p               1e-3;//
        U               1e-3;//
        "(k|epsilon|omega)" 1e-3;//
    }
}
relaxationFactors
{
    equations
    {
        U               0.3; //
        k               0.1; //
        epsilon         0.1;//
        omega           0.1;//
    }
	fields
	{
		p               0.1;//
	}
}


